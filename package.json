{
  "name": "empresti",
  "version": "1.0.0",
  "description": "Gestão de empréstimos de equipamentos.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "db:generate": "prisma generate",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:auth-local": "node --test tests/auth-local.integration.mjs",
    "test:health-local": "node --test tests/health-local.integration.mjs",
    "test:tenant-local": "vitest run --config vitest.tenant-local.config.mts",
    "test:watch": "vitest",
    "test:images-local": "node --test tests/equipment-image-local.integration.mjs",
    "test:initial-data-local": "vitest run --config vitest.initial-data.config.mts",
    "test:loans-local": "vitest run --config vitest.loans-local.config.mts",
    "test:loans-http-local": "node --test tests/loans-http-local.integration.mjs",
    "test:loans-browser-local": "node --test tests/loans-browser-local.integration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiovannaRosaN/empresTI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GiovannaRosaN/empresTI/issues"
  },
  "homepage": "https://github.com/GiovannaRosaN/empresTI#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.3",
    "playwright": "^1.65.0",
    "prisma": "^7.10.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
