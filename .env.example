# ============================================================
#  Emprest — Variables de entorno (modelo)
#  Copia este archivo a `.env.local` y completa los valores.
#  JAMÁS commits este archivo con valores reales.
# ============================================================

# --- Supabase -------------------------------------------------
# Project URL: Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# anon key pública (segura para el cliente/browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# service_role key: SOLO en el servidor. NUNCA en NEXT_PUBLIC_.
# Bypass de RLS: usarla solo en código server-side (tRPC service).
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Prisma (conexión a Supabase Postgres) --------------------
# Para TÚ aplicación usa el pooler de Supabase (puerto 6543):
#   postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Para migraciones/CLI usa la conexión directa (puerto 5432):
DIRECT_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# --- Aplicación ------------------------------------------------
# URL pública de la app (local o el dominio de Vercel en producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000