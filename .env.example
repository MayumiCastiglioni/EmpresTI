# ============================================================
#  Emprest — Variáveis de ambiente (modelo)
#  Copie este arquivo para `.env.local` e preencha os valores.
#  NUNCA commite este arquivo com valores reais.
# ============================================================

# --- Supabase -------------------------------------------------
# Project URL: Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave anon pública (segura para o cliente/navegador)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY

# service_role key: SOMENTE no servidor. NUNCA em NEXT_PUBLIC_.
# Bypass de RLS: use apenas em código server-side (tRPC service).
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# --- Prisma (conexão ao Postgres do Supabase) -----------------
# Para SUA aplicação use o pooler do Supabase (porta 6543):
#   postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Para migrações/CLI use a conexão direta (porta 5432):
DIRECT_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# --- Aplicação ------------------------------------------------
# URL pública da app (local ou o domínio da Vercel em produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000
