generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  COLABORADOR
  OPERACOES
  ADMIN
}

enum EquipmentStatus {
  DISPONIVEL
  RESERVADO
  EMPRESTADO
  MANUTENCAO
  FORA_DE_USO
}

enum LoanStatus {
  SOLICITADO
  RETIRADO
  DEVOLVIDO
  CANCELADO
}

enum ReturnCondition {
  OK
  DANIFICADO
  INCOMPLETO
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships Membership[]
  equipment   Equipment[]
  loans       Loan[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model Membership {
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole @default(COLABORADOR)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Equipment {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  assetTag       String          @map("asset_tag")
  name           String
  category       String
  serialNumber   String?         @map("serial_number")
  pickupLocation String?         @map("pickup_location")
  status         EquipmentStatus @default(DISPONIVEL)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans          Loan[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@map("equipment")
}

model Loan {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  equipmentId       String           @map("equipment_id") @db.Uuid
  borrowerId        String           @map("borrower_id") @db.Uuid
  status            LoanStatus       @default(SOLICITADO)
  requestedAt       DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  checkedOutAt      DateTime?        @map("checked_out_at") @db.Timestamptz(6)
  dueAt             DateTime         @map("due_at") @db.Timestamptz(6)
  returnedAt        DateTime?        @map("returned_at") @db.Timestamptz(6)
  returnedCondition ReturnCondition? @map("returned_condition")
  returnNotes       String?          @map("return_notes")
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment         Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@index([tenantId, borrowerId, status])
  @@index([tenantId, status, dueAt])
  @@index([equipmentId, status])
  @@map("loans")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
